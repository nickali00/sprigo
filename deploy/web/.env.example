# Default: only this computer can connect. Use a LAN or VPN address for other devices.
SPRIGO_BIND_IP=127.0.0.1
SPRIGO_HTTPS_PORT=1431
SPRIGO_CERT_PORT=1432
SPRIGO_MODEL=qwen3:8b
SPRIGO_OLLAMA_URL=http://host.docker.internal:11434
SPRIGO_UID=1000
SPRIGO_GID=1000

# Required for the browser UI, AI proxy and transcription. Generate a random secret.
SPRIGO_ACCESS_PASSWORD=

# Required only while creating accounts. Without it, registration is disabled.
# Generate a different random value with `openssl rand -base64 32`.
SPRIGO_SETUP_SECRET=
